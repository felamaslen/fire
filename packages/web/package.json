{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 4001 --host 0.0.0.0",
    "build": "vite build",
    "start": "vite preview --port 3000",
    "typecheck": "tsc --noEmit && gql.tada check",
    "download-schema": "mkdir -p src/__generated__ && curl -fsSL http://localhost:4000/schema.graphql -o src/__generated__/schema.graphql",
    "codegen": "gql.tada generate-output && tsx scripts/generate-possible-types.ts"
  },
  "dependencies": {
    "@apollo/client": "^4.1.7",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-form": "^1.29.0",
    "@tanstack/react-router": "^1.133.0",
    "@types/apollo-upload-client": "^19.0.0",
    "apollo-upload-client": "^19.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "graphql": "^16.13.2",
    "lucide-react": "^1.8.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/router-plugin": "^1.133.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "gql.tada": "^1.9.2",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.2",
    "vite": "^8.0.8"
  }
