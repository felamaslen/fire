{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "grats": "grats --tsconfig tsconfig.grats.json",
    "codegen": "run-p grats db:generate-schema && gql.tada generate-output",
    "dev": "node --env-file=.env ./node_modules/vite-node/dist/cli.mjs --watch src/index.ts",
    "start": "node --env-file=.env ./node_modules/vite-node/dist/cli.mjs src/index.ts",
    "typecheck": "pnpm grats && tsc --noEmit",
    "test": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs studio",
    "db:generate-schema": "drizzle-kit export --sql > src/db/__generated__/schema.sql"
  },
  "dependencies": {
    "@apollo/server": "^5.5.0",
    "@as-integrations/fastify": "^3.1.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "graphql": "^16.13.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.10",
    "gql.tada": "^1.9.2",
    "grats": "^0.0.36",
    "npm-run-all2": "^8.0.4",
    "typescript": "~5.9.2",
    "vite": "^8.0.8",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.4"
  }
}
