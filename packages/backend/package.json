{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "grats": "grats --tsconfig tsconfig.grats.json",
    "dev": "pnpm grats && tsx watch --env-file=../../.env src/index.ts",
    "start": "pnpm grats && tsx --env-file=../../.env src/index.ts",
    "typecheck": "pnpm grats && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=../../.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --env-file=../../.env ./node_modules/drizzle-kit/bin.cjs studio",
    "db:generate-schema": "drizzle-kit export --sql > src/db/__generated__/schema.sql"
  },
  "dependencies": {
    "@apollo/server": "^5.5.0",
    "@as-integrations/fastify": "^3.1.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "graphql": "^16.13.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.10",
    "grats": "^0.0.36",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  }
}
