{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "grats": "grats --tsconfig tsconfig.grats.json",
    "codegen": "run-p grats db:generate-schema && gql.tada generate-output",
    "dev": "NODE_ENV=development NODE_OPTIONS=\"--import=./otel.mjs\" vite",
    "start": "NODE_ENV=production NODE_OPTIONS=\"--import=./otel.mjs\" vite-node src/index.ts",
    "lint": "eslint --max-warnings=0 src",
    "typecheck": "pnpm grats && tsc --noEmit",
    "test": "vitest",
    "db:generate": "pnpm exec tsx scripts/generate-schema-sql.ts",
    "db:migrate": "pnpm exec tsx scripts/migrator.ts",
    "db:migrate:backfill": "pnpm exec tsx scripts/backfill-migrations.ts",
    "db:migrate:create": "pnpm db:generate && pnpm exec tsx scripts/create-migration",
    "db:studio": "drizzle-kit studio",
    "db:generate-schema": "drizzle-kit export --sql > src/db/__generated__/schema.sql && prettier --write src/db/__generated__/schema.sql",
    "demo:fetch-prices": "tsx scripts/fetch-demo-prices.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.0",
    "@as-integrations/fastify": "^3.1.0",
    "@fastify/otel": "^0.18.1",
    "@fastify/static": "^9.1.1",
    "@google/genai": "^1.50.1",
    "@kubiks/otel-drizzle": "^2.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.215.0",
    "@opentelemetry/core": "^2.7.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.215.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.215.0",
    "@opentelemetry/instrumentation-http": "^0.215.0",
    "@opentelemetry/resources": "^2.7.0",
    "@opentelemetry/sdk-logs": "^0.215.0",
    "@opentelemetry/sdk-node": "^0.215.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@opentelemetry/winston-transport": "^0.25.0",
    "@pgkit/migra": "^0.6.1",
    "@pgkit/migrator": "^0.6.1",
    "dataloader": "^2.2.3",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "graphql": "^16.13.2",
    "graphql-sse": "^2.6.0",
    "graphql-upload": "^17.0.0",
    "lru-cache": "^11.3.5",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "postgres": "^3.4.9",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "yahoo-finance2": "^3.14.0",
    "zod": "^4.3.6",
    "zx": "^8.8.5"
  },
  "devDependencies": {
    "@graphql-tools/schema": "^10.0.32",
    "@graphql-tools/utils": "^11.0.1",
    "@types/graphql-upload": "^17.0.0",
    "@types/node": "^24.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "fake-tag": "^5.0.0",
    "gql.tada": "^1.9.2",
    "grats": "^0.0.36",
    "msw": "^2.13.4",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.3",
    "typescript": "~5.9.2",
    "vite": "^8.0.8",
    "vite-node": "^6.0.0",
    "vite-plugin-node": "^8.0.0",
    "vitest": "^4.1.4"
  }
}
